APP_NAME="Realtor CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8007

# ============================================
# URL CONFIGURATION
# ============================================
# APP_URL: Your application's base URL
#   - Local development: http://localhost:8007
#   - Production: https://yourdomain.com
#   - Network access: http://YOUR_IP:8007
#
# SANCTUM_STATEFUL_DOMAINS: Comma-separated list of domains for Sanctum authentication
#   - Leave empty to auto-detect from APP_URL
#   - Example: "localhost,localhost:3000,yourdomain.com"
#
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
#   - Leave empty for auto-detection (uses APP_URL in production, * in development)
#   - Example: "https://yourdomain.com,https://app.yourdomain.com"
# ============================================

SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=

# Developer API docs (optional). If set, docs URL is: /developer/docs/{this-key}
# If not set, a key is derived from APP_KEY so the URL is unique but not guessable.
# DEVELOPER_DOCS_ACCESS_KEY=your-secret-key-here

# CRM danger action: password required to delete all leads from CRM dashboard (one-click).
# Set to your secret (e.g. 9559180196). If empty, the action is disabled.
# CRM_DANGER_DELETE_ALL_LEADS_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=realtorcrm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Mail - same config for localhost and production (from address shows same everywhere)
# Localhost: MAIL_MAILER=log = no connection needed, emails in storage/logs/laravel.log
# Production: MAIL_MAILER=smtp, MAIL_HOST=smtp.hostinger.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls, real password
MAIL_MAILER=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=support@crm.bihtech.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@crm.bihtech.com
MAIL_FROM_NAME="Base CRM"
