APP_NAME="Realtor CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8007

# ============================================
# URL CONFIGURATION
# ============================================
# APP_URL: Your application's base URL
#   - Local development: http://localhost:8007
#   - Production: https://yourdomain.com
#   - Network access: http://YOUR_IP:8007
#
# SANCTUM_STATEFUL_DOMAINS: Comma-separated list of domains for Sanctum authentication
#   - Leave empty to auto-detect from APP_URL
#   - Example: "localhost,localhost:3000,yourdomain.com"
#
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
#   - Leave empty for auto-detection (uses APP_URL in production, * in development)
#   - Example: "https://yourdomain.com,https://app.yourdomain.com"
# ============================================

SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=realtorcrm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
